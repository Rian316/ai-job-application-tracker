# ------------------------------------------------------------------
# AI Job Application Tracker - Environment Configuration
# Copy this file to .env and fill in the values.
# ------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Job Application Tracker"
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Provider: postgresql (production) or sqlite (local quick-start)
DATABASE_PROVIDER="postgresql"
# Local docker-compose database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobtracker?schema=public"

# --- Auth.js v5 ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="AI Job Tracker <no-reply@yourdomain.com>"

# --- AI (OpenAI) ---
OPENAI_API_KEY=""
# Optional model override
OPENAI_MODEL="gpt-4o-mini"

# --- File storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Google Calendar sync (optional) ---
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# --- Admin bootstrap ---
ADMIN_EMAIL="admin@example.com"

# --- Rate limiting / security (optional) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
