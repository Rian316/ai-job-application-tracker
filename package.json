{
  "name": "ai-job-application-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered job application tracker with analytics, AI cover letters, resume analysis, and interview coaching.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
